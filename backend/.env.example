# =============================================================================
# Agentic RAG Platform - Backend environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="Agentic RAG Platform"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true in production for structured logs

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database --------------------------------------------------------------
# SQLite (default, zero-setup). Postgres example:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agentic_rag
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- File storage ----------------------------------------------------------
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.txt,.docx

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM: Groq -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3

# --- Embeddings ------------------------------------------------------------
EMBEDDING_PROVIDER=local         # local | huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
HF_API_TOKEN=                    # only needed when EMBEDDING_PROVIDER=huggingface

# --- Reranking -------------------------------------------------------------
RERANKER_ENABLED=false           # true enables the cross-encoder (extra model download)
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=5

# --- Vector store ----------------------------------------------------------
VECTOR_STORE=qdrant_local        # qdrant_local | qdrant
QDRANT_PATH=./data/storage/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Chunking --------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5                # final passages sent to the LLM
RETRIEVAL_CANDIDATE_K=20         # candidates per retriever before fusion
RRF_K=60                         # reciprocal rank fusion constant
MIN_RELEVANCE_SCORE=0.15         # below this, treat evidence as insufficient

# --- Agent workflow --------------------------------------------------------
AGENT_MAX_ITERATIONS=8           # hard recursion cap for the LangGraph run
AGENT_MAX_RETRIEVALS=3           # max retrieval tool calls per query
AGENT_TIMEOUT_SECONDS=60
AGENT_ENABLE_QUERY_DECOMPOSITION=true
AGENT_ENABLE_VERIFICATION=true

# --- Evaluation ------------------------------------------------------------
EVAL_ENABLED=false
EVAL_DATASET_PATH=./data/eval/dataset.jsonl
